# Copy this file to keystore.properties (which is gitignored) before generating a signed Play Store release bundle.
# Generate your upload keystore via:
# keytool -genkey -v -keystore mono-upload-key.jks -keyalg RSA -keysize 2048 -validity 10000 -alias mono-upload
storeFile=../mono-upload-key.jks
storePassword=CHANGE_ME
keyAlias=mono-upload
keyPassword=CHANGE_ME
